{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "纪念日",
        "enableShareAppMessage": true,
        "enableShareTimeline": true
      }
    },
    {
      "path": "pages/tools/tools",
      "style": {
        "navigationBarTitleText": "日期工具",
        "enableShareAppMessage": true,
        "enableShareTimeline": true
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "我的",
        "enableShareAppMessage": true,
        "enableShareTimeline": true
      }
    },
    {
      "path": "pages/edit/edit",
      "style": {
        "navigationBarTitleText": "纪念日"
      }
    },
    {
      "path": "pages/privacy/privacy",
      "style": {
        "navigationBarTitleText": "隐私说明"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "纪念日时间计算器",
    "navigationBarBackgroundColor": "#F7F6F3",
    "backgroundColor": "#F7F6F3"
  },
  "tabBar": {
    "color": "#8A8580",
    "selectedColor": "#2F6B5A",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "纪念日",
        "iconPath": "static/tab-home.png",
        "selectedIconPath": "static/tab-home-active.png"
      },
      {
        "pagePath": "pages/tools/tools",
        "text": "工具",
        "iconPath": "static/tab-tools.png",
        "selectedIconPath": "static/tab-tools-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "static/tab-mine.png",
        "selectedIconPath": "static/tab-mine-active.png"
      }
    ]
  }
}
